package templates

import (
	"fmt"
)

type KundenRow struct {
	Kundennummer      int64
	Kundenname        string
	Namenserweiterung string
	IstPrivat         bool
	BriefVersand      bool
	Strasse           string
	Plz               string
	Ort               string
	Landescode        string
	Telefon           string
	Fax               string
	EmailAllgemein    string
	EmailRechnung     string
	Kontaktperson     string
	Iban              string
	Bic               string
	UstIdNr           string
	Steuernummer      string
	LeitwegId         string
	ZahlungszielTage  int
	Zahlungsart       string
	Anmerkungen       string
}

templ KundenPage(rows []KundenRow, search string) {
	<div class="space-y-8 animate-fade-in">
		<div class="flex items-center justify-between">
			<div>
				<h2 class="text-3xl font-extrabold tracking-tight text-white">Kundenstammdaten</h2>
				<p class="text-slate-400 mt-1">Verwalten Sie Ihre Rechnungs- und Lieferempfänger.</p>
			</div>
			
			<a href="/kunden/neu" class="px-4 py-2 bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 font-bold rounded-xl hover:from-emerald-400 hover:to-teal-400 shadow-md shadow-emerald-500/10 hover:shadow-emerald-500/20 transition-all text-sm">
				Neuer Kunde
			</a>
		</div>

		<!-- Filter / Search Bar -->
		<div class="rounded-2xl border border-slate-800 bg-slate-900/20 p-6">
			<form hx-get="/kunden/tabelle" hx-target="#kunden-tabelle-container" hx-trigger="keyup from:input delay:200ms" class="max-w-md">
				<div>
					<label for="kunden-search" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Kundensuche</label>
					<input type="text" id="kunden-search" name="search" placeholder="Name, Nummer, Ort..." value={ search } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2 text-sm text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
				</div>
			</form>
		</div>

		<!-- Table Container -->
		<div id="kunden-tabelle-container" class="rounded-2xl border border-slate-800 bg-slate-900/20 p-6">
			@KundenTable(rows)
		</div>
	</div>
}

templ KundenTable(rows []KundenRow) {
	if len(rows) == 0 {
		<div class="text-center py-12">
			<p class="text-slate-500">Keine Kunden gefunden.</p>
		</div>
	} else {
		<div class="overflow-x-auto">
			<table class="w-full text-left text-sm text-slate-300">
				<thead class="text-xs uppercase text-slate-500 border-b border-slate-800">
					<tr>
						<th class="py-3 px-4">Kundennummer</th>
						<th class="py-3 px-4">Name</th>
						<th class="py-3 px-4">Adresse</th>
						<th class="py-3 px-4">E-Mail (Rechnung)</th>
						<th class="py-3 px-4 text-center">Privat / Brief</th>
						<th class="py-3 px-4 text-center">Zahlungsziel</th>
						<th class="py-3 px-4 text-center">Aktionen</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-800/50">
					for _, r := range rows {
						<tr id={ fmt.Sprintf("kunden-row-%d", r.Kundennummer) } class="hover:bg-slate-900/40 transition-colors">
							<td class="py-3 px-4 font-mono text-emerald-400 font-bold">{ fmt.Sprintf("%d", r.Kundennummer) }</td>
							<td class="py-3 px-4">
								<div class="font-medium text-white">{ r.Kundenname }</div>
								if r.Namenserweiterung != "" {
									<div class="text-xs text-slate-500">{ r.Namenserweiterung }</div>
								}
							</td>
							<td class="py-3 px-4 text-xs text-slate-400">
								if r.Strasse != "" {
									<div>{ r.Strasse }</div>
								}
								<div>{ r.Plz } { r.Ort } ({ r.Landescode })</div>
							</td>
							<td class="py-3 px-4 text-xs text-slate-400 font-mono">
								if r.EmailRechnung != "" {
									{ r.EmailRechnung }
								} else if r.EmailAllgemein != "" {
									<span class="italic text-slate-600">{ r.EmailAllgemein } (allg.)</span>
								} else {
									<span class="text-slate-600 italic">keine</span>
								}
							</td>
							<td class="py-3 px-4 text-center text-xs space-y-1">
								if r.IstPrivat {
									<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] bg-slate-850 text-slate-300 border border-slate-700">Privatkunde</span>
								} else {
									<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] bg-teal-500/10 text-teal-400 border border-teal-500/20">Gewerblich</span>
								}
								<br />
								if r.BriefVersand {
									<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] bg-amber-500/10 text-amber-400 border border-amber-500/20">Briefversand</span>
								} else {
									<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] bg-slate-850 text-slate-400 border border-slate-700">E-Mail</span>
								}
							</td>
							<td class="py-3 px-4 text-center text-xs">
								<div class="font-medium text-slate-200">{ fmt.Sprintf("%d Tage", r.ZahlungszielTage) }</div>
								<div class="text-[10px] text-slate-500">{ r.Zahlungsart }</div>
							</td>
							<td class="py-3 px-4 text-center space-x-2 whitespace-nowrap">
								<a href={ templ.URL(fmt.Sprintf("/kunden/bearbeiten/%d", r.Kundennummer)) } class="text-xs font-semibold text-slate-300 hover:text-white transition-colors bg-slate-800 px-2.5 py-1.5 rounded-lg border border-slate-700">
									Bearbeiten
								</a>
								<button hx-post={ fmt.Sprintf("/kunden/loeschen/%d", r.Kundennummer) } hx-confirm="Möchten Sie diesen Kunden wirklich löschen? Zugehörige Wiegezettel werden ungelinkt bleiben." hx-target={ fmt.Sprintf("#kunden-row-%d", r.Kundennummer) } hx-swap="outerHTML" class="text-xs font-semibold text-rose-400 hover:text-rose-300 transition-colors bg-rose-500/10 px-2.5 py-1.5 rounded-lg border border-rose-500/20 cursor-pointer">
									Löschen
								</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ KundenForm(k *KundenRow, isEdit bool, nextNum int64) {
	<div class="max-w-2xl mx-auto space-y-8 animate-fade-in">
		<div>
			if isEdit {
				<h2 class="text-3xl font-extrabold tracking-tight text-white">Kunde bearbeiten</h2>
				<p class="text-slate-400 mt-1">Ändern Sie die Stammdaten für Kunden #{ fmt.Sprintf("%d", k.Kundennummer) }.</p>
			} else {
				<h2 class="text-3xl font-extrabold tracking-tight text-white">Kunden anlegen</h2>
				<p class="text-slate-400 mt-1">Geben Sie die Stammdaten des neuen Rechnungs- und Lieferempfängers ein.</p>
			}
		</div>

		<div class="rounded-2xl border border-slate-800 bg-slate-900/20 p-8">
			<form action={ templ.URL(func() string {
				if isEdit {
					return fmt.Sprintf("/kunden/bearbeiten/%d", k.Kundennummer)
				}
				return "/kunden/neu"
			}()) } method="POST" class="space-y-6">
				
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<!-- Kundennummer -->
					<div>
						<label for="kundennummer" class="block text-sm font-semibold text-slate-300 mb-2">Kundennummer (10001 - 99999)</label>
						if isEdit {
							<input type="number" id="kundennummer" name="kundennummer" readonly required value={ fmt.Sprintf("%d", k.Kundennummer) } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-500 focus:outline-none cursor-not-allowed" />
						} else {
							<input type="number" id="kundennummer" name="kundennummer" required min="10001" max="99999" value={ fmt.Sprintf("%d", nextNum) } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
						}
					</div>

					<!-- Kundenname -->
					<div>
						<label for="kundenname" class="block text-sm font-semibold text-slate-300 mb-2">Firmenname / Kundenname</label>
						<input type="text" id="kundenname" name="kundenname" required value={ k.Kundenname } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
				</div>

				<!-- Namenserweiterung -->
				<div>
					<label for="namenserweiterung" class="block text-sm font-semibold text-slate-300 mb-2">Namenserweiterung (z.B. GbR, Abteilung)</label>
					<input type="text" id="namenserweiterung" name="namenserweiterung" value={ k.Namenserweiterung } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<!-- Ist Privat -->
					<div class="flex items-center gap-3 bg-slate-950 border border-slate-800 rounded-xl px-4 py-3">
						<input type="checkbox" id="ist_privat" name="ist_privat" value="true" checked?={ k.IstPrivat } class="w-4 h-4 text-emerald-500 bg-slate-900 border-slate-800 rounded focus:ring-emerald-500 focus:ring-2" />
						<label for="ist_privat" class="text-sm font-semibold text-slate-300 cursor-pointer">Privatkunde (keine Umsatzsteuer-Pflicht)</label>
					</div>

					<!-- Brief Versand -->
					<div class="flex items-center gap-3 bg-slate-950 border border-slate-800 rounded-xl px-4 py-3">
						<input type="checkbox" id="brief_versand" name="brief_versand" value="true" checked?={ k.BriefVersand } class="w-4 h-4 text-emerald-500 bg-slate-900 border-slate-800 rounded focus:ring-emerald-500 focus:ring-2" />
						<label for="brief_versand" class="text-sm font-semibold text-slate-300 cursor-pointer">Post- / Briefversand gewünscht</label>
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<!-- Strasse -->
					<div class="md:col-span-2">
						<label for="strasse" class="block text-sm font-semibold text-slate-300 mb-2">Straße & Hausnummer</label>
						<input type="text" id="strasse" name="strasse" value={ k.Strasse } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
					<!-- Landescode -->
					<div>
						<label for="landescode" class="block text-sm font-semibold text-slate-300 mb-2">Landescode</label>
						<input type="text" id="landescode" name="landescode" required value={ func() string { if k.Landescode != "" { return k.Landescode }; return "DE" }() } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<!-- PLZ -->
					<div>
						<label for="plz" class="block text-sm font-semibold text-slate-300 mb-2">Postleitzahl</label>
						<input type="text" id="plz" name="plz" value={ k.Plz } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
					<!-- Ort -->
					<div class="md:col-span-2">
						<label for="ort" class="block text-sm font-semibold text-slate-300 mb-2">Ort</label>
						<input type="text" id="ort" name="ort" value={ k.Ort } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<!-- Telefon -->
					<div>
						<label for="telefon" class="block text-sm font-semibold text-slate-300 mb-2">Telefonnummer</label>
						<input type="text" id="telefon" name="telefon" value={ k.Telefon } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
					<!-- Fax -->
					<div>
						<label for="fax" class="block text-sm font-semibold text-slate-300 mb-2">Faxnummer</label>
						<input type="text" id="fax" name="fax" value={ k.Fax } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<!-- Email Allgemein -->
					<div>
						<label for="email_allgemein" class="block text-sm font-semibold text-slate-300 mb-2">E-Mail (Allgemein)</label>
						<input type="email" id="email_allgemein" name="email_allgemein" value={ k.EmailAllgemein } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
					<!-- Email Rechnung -->
					<div>
						<label for="email_rechnung" class="block text-sm font-semibold text-slate-300 mb-2">E-Mail (Rechnungsempfang)</label>
						<input type="email" id="email_rechnung" name="email_rechnung" value={ k.EmailRechnung } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<!-- Kontaktperson -->
					<div class="md:col-span-2">
						<label for="kontaktperson" class="block text-sm font-semibold text-slate-300 mb-2">Ansprechpartner / Kontaktperson</label>
						<input type="text" id="kontaktperson" name="kontaktperson" value={ k.Kontaktperson } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
					<!-- Leitweg ID -->
					<div>
						<label for="leitweg_id" class="block text-sm font-semibold text-slate-300 mb-2">Leitweg-ID (XRechnung)</label>
						<input type="text" id="leitweg_id" name="leitweg_id" value={ k.LeitwegId } placeholder="z.B. 991-12345-76" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<!-- IBAN -->
					<div>
						<label for="iban" class="block text-sm font-semibold text-slate-300 mb-2">IBAN</label>
						<input type="text" id="iban" name="iban" value={ k.Iban } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
					<!-- BIC -->
					<div>
						<label for="bic" class="block text-sm font-semibold text-slate-300 mb-2">BIC</label>
						<input type="text" id="bic" name="bic" value={ k.Bic } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<!-- UstID -->
					<div>
						<label for="ust_id_nr" class="block text-sm font-semibold text-slate-300 mb-2">Umsatzsteuer-ID (z.B. DE123456789)</label>
						<input type="text" id="ust_id_nr" name="ust_id_nr" value={ k.UstIdNr } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
					<!-- Steuernummer -->
					<div>
						<label for="steuernummer" class="block text-sm font-semibold text-slate-300 mb-2">Steuernummer</label>
						<input type="text" id="steuernummer" name="steuernummer" value={ k.Steuernummer } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<!-- Zahlungsziel -->
					<div>
						<label for="zahlungsziel_tage" class="block text-sm font-semibold text-slate-300 mb-2">Zahlungsziel (in Tagen)</label>
						<input type="number" id="zahlungsziel_tage" name="zahlungsziel_tage" required value={ func() string { if k.ZahlungszielTage > 0 { return fmt.Sprintf("%d", k.ZahlungszielTage) }; return "14" }() } class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors" />
					</div>
					<!-- Zahlungsart -->
					<div>
						<label for="zahlungsart" class="block text-sm font-semibold text-slate-300 mb-2">Zahlungsart</label>
						<select id="zahlungsart" name="zahlungsart" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors">
							<option value="Ueberweisung" selected?={ k.Zahlungsart == "Ueberweisung" || k.Zahlungsart == "" }>Überweisung (Standard)</option>
							<option value="Lastschrift" selected?={ k.Zahlungsart == "Lastschrift" }>Lastschrift</option>
							<option value="Bar" selected?={ k.Zahlungsart == "Bar" }>Barzahlung</option>
						</select>
					</div>
				</div>

				<!-- Anmerkungen -->
				<div>
					<label for="anmerkungen" class="block text-sm font-semibold text-slate-300 mb-2">Interne Anmerkungen</label>
					<textarea id="anmerkungen" name="anmerkungen" rows="3" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-slate-200 focus:outline-none focus:border-emerald-500 transition-colors">{ k.Anmerkungen }</textarea>
				</div>

				<div class="pt-4 border-t border-slate-800 flex gap-4 justify-end">
					<a href="/kunden" class="px-5 py-2.5 bg-slate-900 border border-slate-800 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all text-sm font-medium">
						Abbrechen
					</a>
					<button type="submit" class="px-5 py-2.5 bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 font-bold rounded-xl hover:from-emerald-400 hover:to-teal-400 shadow-md shadow-emerald-500/10 hover:shadow-emerald-500/20 transition-all text-sm">
						Speichern
					</button>
				</div>
			</form>
		</div>
	</div>
}
